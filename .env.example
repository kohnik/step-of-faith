# Скопируйте в .env и заполните. Файл .env не коммитить.
NODE_ENV=development
DATABASE_URL=postgres://sof:sof@localhost:55432/sof

# Токен и username бота из @BotFather (username без @)
BOT_TOKEN=123456:replace-me
BOT_USERNAME=stepoffaith_bot

# Адреса фронтендов (в проде — https://app.stepoffaith.online и https://admin.stepoffaith.online)
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Случайная строка 32+ символов: openssl rand -hex 32
CODE_HASH_SALT=replace-with-random-hex

# Telegram id первых суперадминов через запятую (узнать свой id: @userinfobot)
SUPERADMIN_TG_IDS=

PORT=3000
LOG_LEVEL=info
# Локально cookie без HTTPS
COOKIE_SECURE=false
