{
	email {$ACME_EMAIL}
}

(common) {
	# Поток живых обновлений (/api/events) не сжимаем: сжатие копит байты, и подсказки приходили бы пачкой.
	@compress not path /api/events
	encode @compress zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# API на том же origin, что и фронтенд: без CORS, cookie админки не уходят на другой домен.
	handle /api/events {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}
	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
	# Фото и 3D-модели мерча: имя файла - хеш содержимого, кэш навсегда. Нет файла - честный 404.
	handle /media/* {
		root * /srv
		@glb path *.glb
		header @glb Content-Type "model/gltf-binary"
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		file_server
	}
}

# Mini App, веб-билеты, браузерный сканер
{$APP_DOMAIN} {
	import common
	handle /assets/* {
		# Файлы с хешем в имени: кэш навсегда. Нет файла (старый чанк после выкладки) - честный 404,
		# а не index.html под видом скрипта, который браузер и service worker закэшировали бы на год.
		root * /srv/miniapp
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		file_server
	}
	handle {
		root * /srv/miniapp
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Веб-админка
{$ADMIN_DOMAIN} {
	import common
	header X-Frame-Options "DENY"
	handle /assets/* {
		# Файлы с хешем в имени: кэш навсегда. Нет файла (старый чанк после выкладки) - честный 404,
		# а не index.html под видом скрипта, который браузер и service worker закэшировали бы на год.
		root * /srv/admin
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		file_server
	}
	handle {
		root * /srv/admin
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Лендинг (если задан корневой домен)
{$ROOT_DOMAIN:localhost} {
	encode zstd gzip
	root * /srv/landing
	templates
	file_server
}

# www - на основной домен (запись www в DNS тоже указывает сюда).
www.{$ROOT_DOMAIN:localhost} {
	redir https://{$ROOT_DOMAIN:localhost}{uri} permanent
}

# Прежний адрес админки - на текущий (пустой ADMIN_ALIAS: блок для localhost-заглушки, наружу не виден).
{$ADMIN_ALIAS:admin-alias.localhost} {
	redir https://{$ADMIN_DOMAIN}{uri} permanent
}
