# Прод-настройки для VPS. Скопируйте в .env в корне репозитория НА СЕРВЕРЕ.

# --- домены ---
# Постоянные:  app.stepoffaith.online / admin.stepoffaith.online / stepoffaith.online
# Бесплатные временные (sslip.io, подставьте IP сервера через дефисы): app.1-2-3-4.sslip.io / admin.1-2-3-4.sslip.io
APP_DOMAIN=app.stepoffaith.online
ADMIN_DOMAIN=panel.stepoffaith.online
# Прежний адрес админки - перекидывается на ADMIN_DOMAIN (необязательно)
ADMIN_ALIAS=admin.stepoffaith.online
ROOT_DOMAIN=stepoffaith.online
ACME_EMAIL=you@example.com

APP_URL=https://app.stepoffaith.online
ADMIN_URL=https://panel.stepoffaith.online

# --- бот ---
BOT_TOKEN=
BOT_USERNAME=step_of_faith_2026_bot
# Telegram id суперадминов через запятую (или используйте: docker compose exec api node dist/cli.js invite superadmin)
SUPERADMIN_TG_IDS=

# --- секреты ---
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
CODE_HASH_SALT=

# --- бэкапы в Beget S3 ---
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
# в дни конференции поставьте 15
BACKUP_INTERVAL_MINUTES=60

# --- ежедневная зашифрованная копия базы и чеков (Telegram и/или почта) ---
# Чаты Telegram через запятую (бот должен быть в чате), отправляет тот же бот
BACKUP_TG_CHAT_IDS=
BACKUP_MAIL_TO=
# Во сколько слать (час по BACKUP_TZ, по умолчанию Europe/Minsk)
BACKUP_MAIL_HOUR=22
# Пароль шифрования копий: openssl rand -hex 16. Без него копию не открыть - сохраните отдельно
BACKUP_MAIL_PASSWORD=
# Почта для отправки (для Gmail - пароль приложения)
SMTP_URL=smtps://smtp.gmail.com:465
SMTP_USER=
SMTP_PASSWORD=

LOG_LEVEL=info
DB_POOL_MAX=10

# Живые обновления Mini App: долгие соединения через прокси. Включать на своём сервере.
# На общем Beget-сервере каждый поток занимает память и в общем Caddy других проектов — там false.
REALTIME_ENABLED=false
# Потолок одновременных потоков (сверх — приложение остаётся на опросе).
REALTIME_MAX_STREAMS=1500
