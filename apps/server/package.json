{
  "name": "@sof/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/main-api.ts",
    "dev:bot": "tsx watch --env-file-if-exists=../../.env src/main-bot.ts",
    "build": "node build.mjs",
    "start:api": "node dist/main-api.js",
    "start:bot": "node dist/main-bot.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@grammyjs/auto-retry": "2.0.2",
    "@grammyjs/ratelimiter": "1.2.1",
    "@grammyjs/runner": "2.0.3",
    "@node-rs/argon2": "2.2.1",
    "@sof/shared": "workspace:*",
    "@tma.js/init-data-node": "2.0.8",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "grammy": "1.46.0",
    "otpauth": "9.5.2",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
